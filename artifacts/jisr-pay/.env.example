# Jisr Pay — build-time configuration
#
# Copy to `.env.local` and edit as needed. Every value is OPTIONAL —
# the defaults compile in the current Stellar TESTNET deployment.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Deployed Soroban payment_router contract ID (C...)
#VITE_CONTRACT_ID=CDNQ7OMHIFOLZHOKWQLOGDW7CF3DRMKXJC6OULNGNBWF4O4NO2NEIGER

# Platform treasury account (G...) that receives the route fee
#VITE_TREASURY_ADDRESS=GAAFWEZKDYPXLTQGKQ3F23TXWYQUDAYTDW7P7VUQSVJFW2GWC4Y6LWST

# Sacva-style token contract used by the router (C...)
#VITE_TOKEN_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Federation / recipient directory API base URL
#VITE_FEDERATION_API_BASE=https://stellar-tags-production.up.railway.app

# Soroban RPC endpoint
#VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon REST endpoint
#VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase — set to 'Public Global Stellar Network ; September 2015'
# for mainnet. STELLAR_NETWORK flips from TESTNET to CUSTOM when this is set.
#VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
